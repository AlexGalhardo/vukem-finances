{
	"name": "recurrence-duplicate",
	"description": "Two devices generate the same occurrence offline; the second create is a duplicate of the first and names the uid to adopt, even after the first is deleted.",
	"workspace": {
		"plan": "pro",
		"devices": {
			"a": "owner",
			"b": "owner"
		}
	},
	"steps": [
		{
			"device": "a",
			"action": "push",
			"input": {
				"mutations": [
					{
						"op_id": "01JD5Z8K3M0000000000000P31",
						"entity": "account",
						"uid": "01JD5Z8K3M0000000000000A01",
						"op": "upsert",
						"base_seq": 0,
						"fields": {
							"name": "Checking",
							"kind": "checking"
						}
					},
					{
						"op_id": "01JD5Z8K3M0000000000000P32",
						"entity": "recurrence",
						"uid": "01JD5Z8K3M0000000000000R01",
						"op": "upsert",
						"base_seq": 0,
						"fields": {
							"account_uid": "01JD5Z8K3M0000000000000A01",
							"kind": "expense",
							"amount_cents": 100,
							"frequency": "monthly",
							"start_date": "2026-01-15"
						}
					},
					{
						"op_id": "01JD5Z8K3M0000000000000P33",
						"entity": "transaction",
						"uid": "01JD5Z8K3M0000000000000T01",
						"op": "upsert",
						"base_seq": 0,
						"fields": {
							"account_uid": "01JD5Z8K3M0000000000000A01",
							"kind": "expense",
							"amount_cents": 100,
							"occurred_on": "2026-02-15",
							"recurrence_uid": "01JD5Z8K3M0000000000000R01",
							"occurrence_on": "2026-02-15"
						}
					}
				]
			},
			"expect": {
				"results": [
					{
						"status": "applied"
					},
					{
						"status": "applied"
					},
					{
						"status": "applied"
					}
				]
			}
		},
		{
			"device": "b",
			"action": "push",
			"input": {
				"mutations": [
					{
						"op_id": "01JD5Z8K3M0000000000000P34",
						"entity": "transaction",
						"uid": "01JD5Z8K3M0000000000000T02",
						"op": "upsert",
						"base_seq": 0,
						"fields": {
							"account_uid": "01JD5Z8K3M0000000000000A01",
							"kind": "expense",
							"amount_cents": 100,
							"occurred_on": "2026-02-15",
							"recurrence_uid": "01JD5Z8K3M0000000000000R01",
							"occurrence_on": "2026-02-15"
						}
					}
				]
			},
			"expect": {
				"results": [
					{
						"status": "duplicate",
						"replaced_by_uid": "01JD5Z8K3M0000000000000T01"
					}
				]
			}
		},
		{
			"device": "a",
			"action": "push",
			"input": {
				"mutations": [
					{
						"op_id": "01JD5Z8K3M0000000000000P35",
						"entity": "transaction",
						"uid": "01JD5Z8K3M0000000000000T01",
						"op": "delete",
						"base_seq": "$seen",
						"fields": {}
					}
				]
			},
			"expect": {
				"results": [
					{
						"status": "applied"
					}
				]
			}
		},
		{
			"device": "b",
			"action": "push",
			"note": "a deleted occurrence is never made again",
			"input": {
				"mutations": [
					{
						"op_id": "01JD5Z8K3M0000000000000P36",
						"entity": "transaction",
						"uid": "01JD5Z8K3M0000000000000T03",
						"op": "upsert",
						"base_seq": 0,
						"fields": {
							"account_uid": "01JD5Z8K3M0000000000000A01",
							"kind": "expense",
							"amount_cents": 100,
							"occurred_on": "2026-02-15",
							"recurrence_uid": "01JD5Z8K3M0000000000000R01",
							"occurrence_on": "2026-02-15"
						}
					}
				]
			},
			"expect": {
				"results": [
					{
						"status": "duplicate",
						"replaced_by_uid": "01JD5Z8K3M0000000000000T01",
						"row": null
					}
				]
			}
		}
	],
	"final": {
		"absent": [
			"01JD5Z8K3M0000000000000T01",
			"01JD5Z8K3M0000000000000T02",
			"01JD5Z8K3M0000000000000T03"
		]
	}
}
