{
  "name": "vukem-finances-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.5",
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build && bun scripts/sitemap.ts && bun scripts/twins.ts",
    "preview": "bun --bun astro preview",
    "typecheck": "bun --bun tsc --noEmit",
    "check:claims": "bun scripts/check-claims.ts && bun scripts/check-doc-claims.ts",
    "check:built": "bun scripts/check-built.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "og": "bun scripts/og-image.ts",
    "test:site": "bun test scripts",
    "reference": "bun scripts/generate-reference.ts",
    "reference:check": "bun scripts/reference-check.ts",
    "test:reference": "bun test scripts/reference.test.ts",
    "last-updated": "bun scripts/last-updated.ts",
    "check:last-updated": "bun scripts/last-updated.ts --check",
    "check:mdx": "bun scripts/check-mdx.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
