---
import "../landing/landing.css";
import { absolute, htmlLang, locales, localePath, ogLocale, repoUrl, type Locale } from "../../lib/site.ts";

interface Props {
	locale: Locale;
	title: string;
	description: string;
	/** Path (with base) of this page, for the canonical link. */
	path: string;
	/** Locales with an alternate of this page; empty for pages that exist once. */
	alternates?: boolean;
	ogAlt: string;
	jsonLd?: boolean;
}

const { locale, title, description, path, alternates = false, ogAlt, jsonLd = false } = Astro.props;
const image = absolute(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/og.png`);

const structured = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "vukem-finances",
	applicationCategory: "FinanceApplication",
	operatingSystem: "Windows, macOS, Linux",
	description,
	url: absolute(localePath(locale)),
	license: "https://opensource.org/license/mit",
	codeRepository: repoUrl,
	inLanguage: htmlLang[locale],
};
// "<" never appears raw inside the script element.
const structuredJson = JSON.stringify(structured).replace(/</g, String.raw`\u003c`);
---
<!doctype html>
<html lang={htmlLang[locale]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={absolute(path)} />
		{alternates && locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={absolute(localePath(l))} />)}
		{alternates && <link rel="alternate" hreflang="x-default" href={absolute(localePath("en"))} />}
		<link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} type="image/svg+xml" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="vukem-finances" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={absolute(path)} />
		<meta property="og:locale" content={ogLocale[locale]} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		{jsonLd && <script type="application/ld+json" set:html={structuredJson} />}
	</head>
	<body>
		<slot />
	</body>
</html>
