---
import type { Copy } from "../lib/copy.ts";
import { basePath, docsPath, htmlLang, localeNames, localePath, locales, type Locale } from "../lib/site.ts";

interface Props {
	locale: Locale;
	copy: Copy;
}
const { locale, copy } = Astro.props;
const home = localePath(locale);
---
<header class="site-header">
	<div class="wrap">
		<a class="brand" href={home}>
			vukem-finances
		</a>
		<nav aria-label={copy.a11y.mainNav}>
			<ul class="nav">
				<li><a href={`${home}#features`}>{copy.nav.features}</a></li>
				<li><a href={`${home}#privacy`}>{copy.nav.privacy}</a></li>
				<li><a href={`${home}#editions`}>{copy.nav.editions}</a></li>
				<li><a href={`${home}#install`}>{copy.nav.install}</a></li>
				<li><a href={`${home}#faq`}>{copy.nav.faq}</a></li>
				<li><a href={`${basePath}${docsPath}`}>{copy.footer.docs}</a></li>
			</ul>
		</nav>
		<nav aria-label={copy.a11y.language}>
			<ul class="lang">
				{locales.map((l) => (
					<li><a href={localePath(l)} lang={htmlLang[l]} hreflang={htmlLang[l]} aria-current={l === locale ? "true" : undefined}>{localeNames[l]}</a></li>
				))}
			</ul>
		</nav>
	</div>
</header>
