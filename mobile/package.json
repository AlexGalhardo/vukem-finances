{
  "name": "vukem-finances-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "58.0.26",
    "expo-crypto": "58.0.8",
    "expo-file-system": "58.0.14",
    "expo-local-authentication": "58.0.3",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.32",
    "expo-secure-store": "58.0.3",
    "expo-sharing": "58.0.23",
    "expo-sqlite": "58.0.18",
    "expo-status-bar": "58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.[jt]s?(x)"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/__tests__/integration/"
    ],
    "testTimeout": 30000
  }
}
