APP_NAME=vukem-finances
APP_ENV=development
APP_KEY=
# Former APP_KEY values, comma-separated: they still decrypt after a rotation.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
PORT=3000
DATABASE_URL=file:storage/database.sqlite
# Database queue (QUEUE_CONNECTION=database) tables, prefixed so they never
# collide with an app table such as "jobs". Set before the first boot.
QUEUE_TABLE=queue_jobs
QUEUE_FAILED_TABLE=queue_failed_jobs
ADMIN_EMAILS=admin@example.test
# The edition of the binary: personal (the default when unset) or saas; any
# other value stops the boot. personal: one implicit workspace, no billing, no
# public sign-up, no landing page, no plan limits; the first owner is created
# at /setup and the other people join by invite link. saas: public sign-up,
# many workspaces, Stripe billing and plan limits; set it explicitly in production.
APP_EDITION=personal
# personal only: the secret that /setup asks for. Leave empty to use the
# one-time code the server prints in its boot log ("setup code: ...").
SETUP_TOKEN=

# Stripe (vukem install:billing), saas only: personal never reads these.
# Develop in a sandbox: stripe sandbox create.
# A restricted key (rk_...) with only the billing permissions.
STRIPE_KEY=
# stripe listen --forward-to localhost:3000/stripe/webhook prints whsec_...
STRIPE_WEBHOOK_SECRET=
# Recurring price ids (price_...) of the plans in config/billing.go.
STRIPE_PRICE_PRO=
# Currencies a checkout may ask for (e.g. brl,usd,eur); empty uses each
# price's default currency. Prices need currency_options for the others.
STRIPE_CURRENCIES=

# Mail. Development writes mails to the log; production sends them with Resend:
# MAIL_MAILER=resend, a verified sending domain in MAIL_FROM, an API key and
# the signing secret of the webhook that reports bounces and complaints
# (Resend dashboard, Webhooks: POST /webhooks/resend, email.bounced and
# email.complained).
MAIL_MAILER=log
# saas: a sign-up is a self-asserted address, so verification is always on and
# production refuses any value but true (or unset). personal: accounts come
# from /setup and invite links and are created verified; the flag has no effect.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
MAIL_FROM="Finance <no-reply@example.com>"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# AI (bring your own key, docs/ai.md): the owner saves a provider key in the
# app, encrypted with APP_KEY. personal only: true lets the OpenAI-compatible
# provider reach a model server on this machine or a private network (http is
# then accepted for those hosts). saas ignores it.
AI_ALLOW_PRIVATE_HOSTS=false

# Optional Google sign-in. Leave both empty to use password login only.
# Set both together, and register SOCIAL callback http://localhost:3000/auth/google/callback.
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=

# Local administrator created by vukem db:seed (development and test only).
# Leave the password empty to generate one into storage/finance-admin-*.txt.
FINANCE_ADMIN_EMAIL=admin@example.test
FINANCE_ADMIN_PASSWORD=

# docker compose (compose.yaml) runs the app with a mail catcher: it sets
# MAIL_MAILER=smtp, SMTP_HOST=mailpit and SMTP_PORT=1025, and the inbox is at
# http://localhost:8025. Nothing to add here for mail. Compose also sets
# APP_EDITION (personal unless the shell sets another) and keeps the SQLite
# file in the storage volume.

# compose.prod.yaml (the VPS stack with Caddy): the public host name Caddy gets
# a certificate for, whose DNS record must already point at the server. Compose
# reads it from here or from the shell. See deploy/README.md.
APP_DOMAIN=

# How many days a deleted row (a tombstone) and its change-log entries are kept
# before the nightly compaction purges them. 30 or more (the restore window).
# TOMBSTONE_RETENTION_DAYS=90
